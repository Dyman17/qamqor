datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FarmRole {
  OWNER
  WORKER
}

enum SignalLevel {
  SOUND
  VIBRATION
  IMPULSE
}

enum AnimalSpecies {
  HORSE
  CAMEL
  CATTLE
  SHEEP
  GOAT
}

enum AnimalGender {
  MALE
  FEMALE
  UNKNOWN
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  NO_GPS
  INACTIVE
}

enum AlertType {
  GEOFENCE_BREACH
  GEOFENCE_RETURN
  DEVICE_OFFLINE
  GPS_LOST
  DEVICE_RESTORED
  SIGNAL_LIMIT_REACHED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  fullName     String
  phone        String?
  // JWTs issued before this moment are rejected (set on password reset).
  passwordChangedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  farmMembers  FarmMember[]
  ownedFarms   Farm[]       @relation("FarmOwner")
  sentInvitations Invitation[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Farm {
  id              String           @id @default(uuid())
  name            String
  description     String?
  ownerId         String
  owner           User             @relation("FarmOwner", fields: [ownerId], references: [id])
  // Worker may draw/edit borders and move herds only when the owner switches this on.
  workerCanEditBoundaries Boolean  @default(false)
  // IANA zone; day boundaries for daily signal limits. Asia/Aqtau = UTC+5 (Mangystau).
  timezone        String           @default("Asia/Aqtau")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  members         FarmMember[]
  animals         Animal[]
  devices         Device[]
  geofences       Geofence[]
  alerts          Alert[]
  cameraSnapshots CameraSnapshot[]
  signalLimits    SignalLimit[]
  signalEvents    SignalEvent[]
  invitations     Invitation[]

  @@map("farms")
}

model FarmMember {
  id        String   @id @default(uuid())
  userId    String
  farmId    String
  role      FarmRole @default(WORKER)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([userId, farmId])
  @@map("farm_members")
}

model Device {
  id                String           @id @default(uuid())
  deviceId          String           @unique // e.g. "QAM-0001" or "QAM-CAM-0001"
  secretHash        String           @unique // SHA-256 (hex) of the device secret; the secret itself is never stored
  isSimulated       Boolean          @default(false)
  status            DeviceStatus     @default(INACTIVE)
  signal            Int?             // dBm RSSI
  firmwareVersion   String?          @default("1.0.0")
  lastHeartbeatAt   DateTime?
  farmId            String?
  farm              Farm?            @relation(fields: [farmId], references: [id], onDelete: SetNull)
  animalId          String?          @unique
  animal            Animal?          @relation(fields: [animalId], references: [id], onDelete: SetNull)

  telemetries       Telemetry[]
  alerts            Alert[]
  commands          DeviceCommand[]
  cameraSnapshots   CameraSnapshot[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([farmId])
  @@map("devices")
}

model Animal {
  id                String           @id @default(uuid())
  farmId            String
  farm              Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name              String           // e.g. "Қарагер"
  tagNumber         String           // Ear tag number (unique within a farm)
  species           AnimalSpecies
  gender            AnimalGender     @default(UNKNOWN)
  breed             String?
  birthDate         DateTime?
  photoUrl          String?

  device            Device?
  activeGeofenceId  String?
  activeGeofence    Geofence?        @relation(fields: [activeGeofenceId], references: [id], onDelete: SetNull)

  // Last known state cache
  lastLatitude      Float?
  lastLongitude     Float?
  lastAccuracy      Float?
  lastSeenAt        DateTime?
  isOutsideGeofence Boolean          @default(false)

  telemetries       Telemetry[]
  alerts            Alert[]
  cameraSnapshots   CameraSnapshot[]
  signalEvents      SignalEvent[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([farmId, tagNumber])
  @@index([farmId])
  @@map("animals")
}

model Geofence {
  id          String   @id @default(uuid())
  farmId      String
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#10B981")
  polygonJson Json
  isActive    Boolean  @default(true)

  animals     Animal[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([farmId])
  @@map("geofences")
}

model Telemetry {
  id                String   @id @default(uuid())
  deviceId          String
  device            Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  animalId          String?
  animal            Animal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)
  latitude          Float
  longitude         Float
  accuracy          Float
  signal            Int?
  isOutsideGeofence Boolean  @default(false)
  timestamp         DateTime
  createdAt         DateTime @default(now())

  @@index([deviceId, timestamp(sort: Desc)])
  @@index([animalId, timestamp(sort: Desc)])
  @@map("telemetry")
}

model Alert {
  id          String        @id @default(uuid())
  farmId      String
  farm        Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animalId    String?
  animal      Animal?       @relation(fields: [animalId], references: [id], onDelete: SetNull)
  deviceId    String?
  device      Device?       @relation(fields: [deviceId], references: [deviceId], onDelete: SetNull)
  type        AlertType
  severity    AlertSeverity @default(WARNING)
  status      AlertStatus   @default(ACTIVE)
  message     String
  latitude    Float?
  longitude   Float?
  resolvedAt  DateTime?
  isRead      Boolean       @default(false)
  // "<type>:<animalId>" while ACTIVE; a partial UNIQUE index (WHERE status = 'ACTIVE' AND dedupeKey
  // IS NOT NULL) created in migration 0007_alert_dedupe makes alert creation idempotent under races.
  // Prisma cannot express partial indexes; do not let `migrate dev` drop it.
  dedupeKey   String?
  createdAt   DateTime      @default(now())

  @@index([farmId, status])
  @@index([farmId, createdAt(sort: Desc)])
  @@index([animalId, type, status])
  @@map("alerts")
}

model CameraSnapshot {
  id         String   @id @default(uuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  animalId   String?
  animal     Animal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)
  farmId     String
  farm       Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  imageUrl   String   // File path or base64 data URI
  trigger    String   @default("MANUAL_REQUEST") // MANUAL_REQUEST, GEOFENCE_BREACH, PERIODIC, MOCK_TEST
  fileSize   Int?     // bytes
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([farmId, capturedAt(sort: Desc)])
  @@index([animalId, capturedAt(sort: Desc)])
  @@map("camera_snapshots")
}

model DeviceCommand {
  id         String    @id @default(uuid())
  deviceId   String
  device     Device    @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  command    String    // CAPTURE_PHOTO, BUZZER_ON, BUZZER_OFF, LOCATE_IMMEDIATELY
  payload    Json?     // Optional params
  status     String    @default("PENDING") // PENDING, EXECUTED, CANCELLED
  executedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([deviceId, status])
  @@map("device_commands")
}

/// Daily per-animal signal limits of a farm. dailyLimit null = not set (no suppression);
/// unlimited = true = explicitly no suppression. Integer >= 1 only (enforced by the API).
model SignalLimit {
  id         String      @id @default(uuid())
  farmId     String
  farm       Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  level      SignalLevel
  dailyLimit Int?
  unlimited  Boolean     @default(false)
  updatedAt  DateTime    @updatedAt

  @@unique([farmId, level])
  @@map("signal_limits")
}

/// Invitation of a worker by email. Only the SHA-256 of the token is stored.
model Invitation {
  id          String    @id @default(uuid())
  farmId      String
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([farmId, email])
  @@map("invitations")
}

/// One-time password reset token (1 hour). Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// One signal actually delivered to an animal (counted against the daily limits).
/// Test signals requested from the app are not recorded.
model SignalEvent {
  id       String      @id @default(uuid())
  farmId   String
  farm     Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animalId String
  animal   Animal      @relation(fields: [animalId], references: [id], onDelete: Cascade)
  deviceId String?
  level    SignalLevel
  at       DateTime    @default(now())

  @@index([farmId, animalId, at])
  @@index([animalId, level, at])
  @@map("signal_events")
}
