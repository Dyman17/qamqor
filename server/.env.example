# Qamqor API environment. Placeholders only: never commit real values.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (read from the environment only)
DATABASE_URL=

# Required, at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins (required in production)
CORS_ORIGINS=

# Public web/app base URL used in invitation and password reset emails (optional)
APP_BASE_URL=

# Reverse-proxy hops to trust for the client IP (rate limiter). Default: 1 in production, 0 otherwise
TRUST_PROXY_HOPS=

# Collar ping intervals (seconds)
NORMAL_PING_INTERVAL_SEC=300
EMERGENCY_PING_INTERVAL_SEC=60
# Live mode: while someone watches the farm on the web map (SSE stream) its claimed collars ping this often (1..60 s),
# and for LIVE_LINGER_SEC after the last viewer left. State is in memory (single server instance).
LIVE_PING_INTERVAL_SEC=1
LIVE_LINGER_SEC=120
# Ping interval told to a collar that is not claimed by any farm yet
UNCLAIMED_PING_INTERVAL_SEC=30
# At most one sound and one vibration signal per animal per this many seconds (0 = off)
SIGNAL_COOLDOWN_SEC=30
# A collar's telemetry row is stored at most this often unless something changed (0 = every ping)
TELEMETRY_STORE_MIN_SEC=10

# Collar is OFFLINE after this many missed normal pings (3 x 300 s = 900 s)
OFFLINE_AFTER_MISSED_PINGS=3
# Offline watcher period (seconds); set SCHEDULER_ENABLED=false to turn it off
OFFLINE_CHECK_INTERVAL_SEC=60
SCHEDULER_ENABLED=true

# Demo modes (MANUAL pilot / AUTO simulation). On by default; set to false to switch them off:
# the simulation routes then answer 404 and the simulator never starts.
DEMO_MODES_ENABLED=true
# Simulator tick (seconds) and the shortened demo-only "collar is silent" threshold of the AUTO scenario
SIM_TICK_SEC=10
SIM_DEMO_OFFLINE_SEC=90

# Seed only (development): owner password; random if empty
SEED_OWNER_PASSWORD=
