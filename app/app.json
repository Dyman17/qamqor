{
  "expo": {
    "name": "Qamqor",
    "slug": "qamqor-app",
    "version": "1.0.0",
    "extra": {
      "apiUrl": "https://qamqor-api.onrender.com/api/v1"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0d1f14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.qamqor.app"
    },
    "android": {
      "package": "kz.qamqor.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1f14"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
