{
  "name": "qamqor-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Qamqor - IoT Smart Livestock Monitoring Platform",
  "author": "Qamqor Team",
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "dev:api": "pnpm --filter @qamqor/api run start:dev",
    "dev:web": "pnpm --filter @qamqor/web run dev",
    "dev:simulator": "pnpm --filter @qamqor/simulator run start",
    "prisma:generate": "pnpm --filter @qamqor/api run prisma:generate",
    "prisma:migrate": "pnpm --filter @qamqor/api run prisma:migrate",
    "prisma:studio": "pnpm --filter @qamqor/api run prisma:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.16.1"
}
