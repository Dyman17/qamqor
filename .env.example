# ==========================================
# QAMQOR ENVIRONMENT CONFIGURATION
# ==========================================

# Application Port
PORT=4000
NODE_ENV=development

# Web Frontend URL
WEB_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
# Local Docker or Neon / Render
DATABASE_URL="postgresql://qamqor:qamqor_secret_2026@localhost:5432/qamqor_db?schema=public"

# JWT Authentication
JWT_SECRET="qamqor_jwt_dev_super_secret_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Device Ingestion Security
# Default fallback secret or master ingestion secret for dev/simulators
DEVICE_MASTER_SECRET="qamqor_esp32_device_shared_key_2026"

# Telemetry defaults
DEFAULT_TELEMETRY_INTERVAL_SECONDS=300
EMERGENCY_TELEMETRY_INTERVAL_SECONDS=60

